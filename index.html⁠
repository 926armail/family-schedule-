<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>График дежурств</title>
    <!-- Подключаем стили Telegram -->
    <script src="https://telegram.org/js/telegram-web-app.js"></script>
    <style>
        body {
            background-color: var(--tg-theme-bg-color, #f4f4f5);
            color: var(--tg-theme-text-color, #000000);
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
            text-align: center;
            padding: 20px;
            margin: 0;
        }
        h2 { margin-bottom: 20px; font-size: 22px; }
        input[type="date"] {
            padding: 12px;
            font-size: 18px;
            border-radius: 8px;
            border: 1px solid #ccc;
            width: 90%;
            max-width: 300px;
            margin-bottom: 30px;
            font-family: inherit;
        }
        .result-box {
            padding: 20px;
            border-radius: 12px;
            font-size: 22px;
            font-weight: bold;
            color: white;
            display: inline-block;
            width: 90%;
            max-width: 300px;
            box-shadow: 0 4px 6px rgba(0,0,0,0.1);
            transition: background-color 0.3s ease;
        }
        .details {
            margin-top: 15px;
            font-size: 16px;
            color: var(--tg-theme-hint-color, #707579);
            line-height: 1.5;
        }
    </style>
</head>
<body>
    <h2>Кто сегодня дома?</h2>
    
    <input type="date" id="datePicker" />
    <br>
    <div id="resultBox" class="result-box" style="background-color: #9e9e9e;">Выберите дату</div>
    <div class="details" id="detailsBox"></div>

    <script>
        // Инициализация Telegram (чтобы приложение открывалось на весь экран)
        const tg = window.Telegram.WebApp;
        tg.expand(); 

        const datePicker = document.getElementById('datePicker');
        const resultBox = document.getElementById('resultBox');
        const detailsBox = document.getElementById('detailsBox');

        // Ставим сегодняшнюю дату при открытии приложения
        const today = new Date();
        const yyyy = today.getFullYear();
        const mm = String(today.getMonth() + 1).padStart(2, '0');
        const dd = String(today.getDate()).padStart(2, '0');
        datePicker.value = `${yyyy}-${mm}-${dd}`;

        function updateSchedule() {
            if (!datePicker.value) return;
            
            // Надежный парсинг даты для защиты от сдвигов часовых поясов
            const [year, month, day] = datePicker.value.split('-');
            const targetDate = new Date(year, month - 1, day);
            
            // --- ГРАФИК ЖЕНЩИНЫ ---
            // Старт цикла: 16 сентября 2026 (рабочий день)
            const womanAnchor = new Date(2026, 8, 16);
            const msPerDay = 1000 * 60 * 60 * 24;
            const daysDiffWoman = Math.round((targetDate - womanAnchor) / msPerDay);
            
            // Вычисляем день в 10-дневном цикле
            let womanCycleDay = daysDiffWoman % 10;
            if (womanCycleDay < 0) womanCycleDay += 10; 
            
            // Дни цикла: 0,1 (раб) -> 2,3,4 (вых) -> 5,6,7 (раб) -> 8,9 (вых)
            const womanWorks = [0, 1, 5, 6, 7].includes(womanCycleDay);

            // --- ГРАФИК МУЖЧИНЫ ---
            const dayOfWeek = targetDate.getDay(); // 0 - Вс, 1 - Пн, 2 - Вт, 3 - Ср, 4 - Чт, 5 - Пт, 6 - Сб
            let manWorks = false;
            
            if (dayOfWeek === 2 || dayOfWeek === 4) {
                // Вторник и четверг всегда рабочие
                manWorks = true;
            } else if (dayOfWeek === 5) {
                // Пятницы чередуются. Опорная: 18 сентября 2026 (рабочая)
                const manAnchor = new Date(2026, 8, 18);
                const daysDiffMan = Math.round((targetDate - manAnchor) / msPerDay);
                const weeksDiff = Math.abs(Math.round(daysDiffMan / 7));
                
                if (weeksDiff % 2 === 0) {
                    manWorks = true; // Четные недели — работает
                } else {
                    manWorks = false; // Нечетные — отдыхает
                }
            }

            // --- ВЫВОД РЕЗУЛЬТАТА НА ЭКРАН ---
            if (!manWorks && !womanWorks) {
                // Оба выходные (Оба дома)
                resultBox.innerHTML = "🏠 Оба дома";
                resultBox.style.backgroundColor = "#4CAF50"; // Зеленый цвет
            } else if (!manWorks && womanWorks) {
                // Мужчина выходной, Женщина работает (Только мужчина дома)
                resultBox.innerHTML = "👨 Только мужчина";
                resultBox.style.backgroundColor = "#2196F3"; // Синий цвет
            } else if (manWorks && !womanWorks) {
                // Мужчина работает, Женщина выходная (Только женщина дома)
                resultBox.innerHTML = "👩 Только женщина";
                resultBox.style.backgroundColor = "#E91E63"; // Розовый цвет
            } else {
                // Оба работают
                resultBox.innerHTML = "🏢 Обоих нет";
                resultBox.style.backgroundColor = "#607D8B"; // Серый цвет
            }
            
            // Текстовая расшифровка снизу
            let manStatus = manWorks ? "на работе" : "дома (выходной)";
            let womanStatus = womanWorks ? "на работе" : "дома (выходной)";
            detailsBox.innerHTML = `👨 Мужчина: ${manStatus} <br> 👩 Женщина: ${womanStatus}`;
        }

        // Запускаем расчет при смене даты и при первой загрузке
        datePicker.addEventListener('change', updateSchedule);
        updateSchedule(); 
    </script>
</body>
</html>
